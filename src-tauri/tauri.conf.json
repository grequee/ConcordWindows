{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Concord",
  "version": "0.1.0",
  "identifier": "chat.concord.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Concord",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#101311",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "Comunicação privada por voz, texto e tela",
    "longDescription": "Concord é um cliente privado de voz, texto e compartilhamento de tela para pequenos grupos. A mídia é nativa em Rust e não usa o WebView.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libstdc++6",
          "libpipewire-0.3-0",
          "libspeexdsp1",
          "xdg-desktop-portal",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/concord/libvpx.so.12": "../target/linux-libs/libvpx.so.12",
          "/usr/lib/concord/libyuv.so": "../target/linux-libs/libyuv.so",
          "/usr/lib/concord/libjpeg.so.8": "../target/linux-libs/libjpeg.so.8"
        }
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libstdc++",
          "pipewire-libs",
          "speexdsp",
          "xdg-desktop-portal",
          "libayatana-appindicator-gtk3"
        ],
        "files": {
          "/usr/lib/concord/libvpx.so.12": "../target/linux-libs/libvpx.so.12",
          "/usr/lib/concord/libyuv.so": "../target/linux-libs/libyuv.so",
          "/usr/lib/concord/libjpeg.so.8": "../target/linux-libs/libjpeg.so.8"
        }
      }
    }
  }
}
